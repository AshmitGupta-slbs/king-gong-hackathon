    "lint": "eslint",
    "test:gate": "tsx scripts/test-gate.ts",
    "samples": "tsx scripts/make-samples.ts",
    "test:harness": "tsx scripts/test-harness.ts",
    "extract:samples": "tsx scripts/extract-samples.ts",
    "check:ship": "tsx scripts/check-ship.ts",
    "check:model": "tsx scripts/check-model.ts",
    "verify": "tsx scripts/test-gate.ts && tsx scripts/test-harness.ts && tsx scripts/test-readability.ts && tsx scripts/check-ship.ts",
