# ── Nothing here is required to run the bundled demo. ────────────────────────
# `npm run dev` works with an empty environment: the five sample calls are
# committed, and a PyAI sandbox key mints itself on first use.

# ── PyAI (speech-to-text) ───────────────────────────────────────────────────
# Leave unset and a free sandbox key (pyai_test_...) is minted automatically —
# no signup, no card. Set this only to use your own key.
#
# Sandbox keys are capped per day (resets 00:00 UTC) AND the minting allowance is per NETWORK,
# not per key — so once a network is spent, minting another key does not help. If a capped key
# blocks you, `npm run check:key` says so and when it lifts. For a key with no daily cap, create
# an account at https://console.pyai.com and put the pyai_live_ key here; the app will never
# auto-replace a live key with a sandbox one.
# PYAI_API_KEY=
# PYAI_BASE_URL=https://api.pyai.com/v1

# ── Extraction model — ONE of the following ─────────────────────────────────
# The provider is auto-detected from whichever credentials are present.
# With none of them set, extraction falls back to a keyword stub that is
# clearly labelled in the UI and is NOT a substitute for a model.

# (a) Anthropic first-party
# ANTHROPIC_API_KEY=sk-ant-...

# (b) Claude on AWS Bedrock. Keys are optional under an IAM role — leave them
#     unset and the default AWS credential chain is used.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# Optional: temporary credentials from STS.
# AWS_SESSION_TOKEN=
# OPTIONAL. Only used when LLM_MODEL is a bare application-inference-profile id,
# which is expanded to
#   arn:aws:bedrock:${AWS_REGION}:${account}:application-inference-profile/${id}
# If unset, the account is derived once via sts:GetCallerIdentity (which needs no
# IAM permission of its own), so you can leave this blank.
# AWS_ACCOUNT_ID=

# ── Which model writes the notes ────────────────────────────────────────────
# LLM_PROVIDER picks the engine explicitly instead of auto-detecting. An
# unrecognised value FAILS rather than falling back, so a typo cannot quietly
# turn into stub-generated notes that look like model output.
#   anthropic_bedrock | aws_bedrock | bedrock   → Claude on AWS Bedrock
#   anthropic | anthropic_api | claude          → Anthropic first-party
#   stub | stub_heuristic | heuristic | none    → the keyword stub (not a model)
# LLM_PROVIDER=anthropic_bedrock

# LLM_MODEL. On Bedrock, four shapes are accepted and each is handled correctly
# (lib/bedrock-model-id.ts) — getting this wrong is what produces a 404 that
# looks like a region problem:
#   (unset)                               defaults to a cross-region inference
#                                         profile that works with nothing else
#                                         configured.
#   3s3wyt6beb2x                          a bare application-inference-profile
#                                         id, your team's cost-tracking profile.
#                                         Expanded to a full ARN; the account
#                                         comes from AWS_ACCOUNT_ID or STS.
#   arn:aws:bedrock:...:application-inference-profile/xxx   used verbatim
#   global.anthropic.claude-sonnet-4-6    cross-region profile, used verbatim
#   claude-opus-5                         foundation id; routed through a
#                                         cross-region profile, because an
#                                         account without provisioned throughput
#                                         cannot invoke one on-demand
# LLM_MODEL=global.anthropic.claude-sonnet-4-6

# ── Overrides (all optional) ────────────────────────────────────────────────
# OPENGONG_STT=pyai-jobs          # pyai-jobs | fixture
# OPENGONG_TTS=macos-say          # macos-say | pyai-speak  (sample generation only)
# OPENGONG_EFFORT=high            # low | medium | high | xhigh | max

# Citation gate: minimum content-word overlap for a claim to count as verified.
# OPENGONG_SUPPORT_THRESHOLD=0.18

# Where account, contact and deal context comes from. The default serves FABRICATED demo
# records for the five committed sample calls, labelled as such everywhere they appear.
# An unknown value throws rather than falling back, so a missing adapter can never render
# invented contacts under a real customer's name.
# CRM_PROVIDER=fixture            # fixture

# Budget governor — enforced before each model call.
# OPENGONG_MAX_INPUT_TOKENS=180000
# OPENGONG_MAX_OUTPUT_TOKENS=16000
# OPENGONG_MAX_WALL_MS=180000
# OPENGONG_MAX_USD=1.0
# OPENGONG_MAX_ATTEMPTS=2
