# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...but .env.example MUST ship: the README tells you to copy it, and every option is documented
# there. `.env*` above would silently swallow it, so a cloner would follow an instruction that
# cannot work.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── OpenGong Lite ────────────────────────────────────────────────────────────
# EVERY COMMENT IN THIS FILE MUST BE ON ITS OWN LINE. Git only treats `#` as a comment at the
# START of a line — a trailing `pattern    # note` is one literal pattern containing spaces and a
# hash, so it matches nothing and the rule silently does nothing at all.
#
# This is not hypothetical: these four rules were written with trailing comments and every one of
# them was dead, which meant `.pyai-key.json` — holding a live minted PyAI key — was staged for a
# public repo. Verify any change here with `git check-ignore -v <path>`, never by eye.

# local SQLite database
/data/

# auto-minted PyAI sandbox key — never commit
.pyai-key.json

# user-uploaded call audio. Lives under /data/ (already ignored above) because a file written into
# public/ after `next build` is invisible in production — see app/api/audio/[file]/route.ts. The old
# location stays listed so an existing working copy does not suddenly start offering to commit it.
/public/uploads/
/data/uploads/

.env
.env.local

# Python probe virtualenv — 17MB, must never ship in a clone
.venv/
scripts/probe/.venv/

# probe-minted PyAI sandbox key — never commit
scripts/probe/sandbox-key.json

# Python bytecode from the probe scripts
__pycache__/
*.pyc
